---
import PortfolioLayout from './PortfolioLayout.astro';
import { portfolio, siteEmail, type Locale } from '../data/portfolio';
interface Props {lang: Locale;}
const { lang } = Astro.props;
const t = portfolio[lang];
const href = (path: string) => (lang === 'en' ? '/en' : '') + path;
---
<PortfolioLayout lang={lang} active="cv" title={(lang === 'zh' ? '简历与经历' : 'Resume & Experience') + ' | ' + t.name}>
  <p class="section-label">{lang === 'zh' ? '个人履历' : 'Curriculum Vitae'}</p>
  <h1 class="text-4xl md:text-5xl font-bold mt-3">{lang === 'zh' ? '简历与经历' : 'Resume & Experience'}</h1>
  <p class="mt-6 text-base-content/75 leading-8">{t.cvIntro}</p>
  <div class="flex flex-wrap gap-3 mt-7">
    <a href={'mailto:' + siteEmail} class="btn btn-primary btn-sm">{t.contact} ↗</a>
    <a href={href('/projects/')} class="btn btn-outline btn-sm">{t.primaryCTA}</a>
  </div>
  <section class="mt-14"><h2 class="text-2xl font-bold mb-6">{t.sectionEducation}</h2>
    <div class="space-y-4">{t.education.map(e => <article class="research-card">
      <div class="flex flex-wrap justify-between gap-2 items-baseline"><h3 class="text-xl font-bold">{e.school}</h3><span class="text-sm opacity-65">{e.date}</span></div>
      <p class="font-medium mt-2">{e.degree}</p>
      <ul class="list-disc pl-5 mt-3 space-y-2 text-base-content/75">{e.lines.map(line => <li>{line}</li>)}</ul>
    </article>)}</div>
  </section>
  <section class="mt-14"><h2 class="text-2xl font-bold mb-6">{t.sectionIntern}</h2>
    <article class="research-card">
      <div class="flex flex-wrap justify-between gap-2 items-baseline"><h3 class="text-xl font-bold">{t.internship.company} · {t.internship.role}</h3><span class="text-sm opacity-65">{t.internship.date}</span></div>
      <p class="font-medium mt-3">{t.internship.direction}</p>
      <ul class="list-disc pl-5 mt-4 space-y-3 leading-7 text-base-content/80">{t.internship.bullets.map(b => <li>{b}</li>)}</ul>
    </article>
  </section>
  <section class="mt-14"><div class="flex justify-between gap-3 mb-6 items-end"><h2 class="text-2xl font-bold">{t.sectionResearch}</h2><a class="link link-primary" href={href('/projects/')}>{t.allProjects} →</a></div>
    <div class="space-y-4">{t.projects.map(p => <article class="research-card">
      <p class="section-label">{p.category} · {p.period}</p>
      <h3 class="text-xl font-bold mt-2"><a class="hover:text-primary" href={href('/projects/' + p.slug + '/')}>{p.name} ↗</a></h3>
      <p class="text-base-content/75 mt-3 leading-7">{p.short}</p>
      <p class="text-sm mt-3 opacity-70">{t.projectLabels.role}：{p.role}</p>
    </article>)}</div>
  </section>
  <section class="mt-14"><h2 class="text-2xl font-bold mb-6">{t.sectionSkills}</h2>
    <div class="grid md:grid-cols-2 gap-4">{t.skills.map(s => <div class="research-card">
      <h3 class="text-lg font-semibold">{s.label}</h3><div class="flex flex-wrap gap-2 mt-4">{s.items.map(item => <span class="badge badge-outline h-auto min-h-6 py-1 text-left">{item}</span>)}</div>
    </div>)}</div>
  </section>
  <section class="mt-14"><h2 class="text-2xl font-bold mb-6">{t.sectionPapers}</h2>
    <div class="space-y-3">{t.papers.map(p => <div class="research-card"><h3 class="font-semibold leading-7">{p.name}</h3><div class="text-sm text-base-content/65 mt-2">{p.venue} · <strong>{p.status}</strong></div></div>)}</div>
  </section>
  <section class="mt-14"><h2 class="text-2xl font-bold mb-6">{t.sectionHonors}</h2>
    <ul class="list-disc pl-6 space-y-3 leading-7">{t.honors.map(a => <li>{a}</li>)}</ul>
  </section>
  <section class="mt-14 rounded-2xl bg-base-200 p-7"><h2 class="text-xl font-bold">{t.contact}</h2><p class="mt-3 text-base-content/70">{t.contactDesc}</p><a class="link link-primary break-all inline-block mt-4" href={'mailto:' + siteEmail}>{siteEmail}</a></section>
</PortfolioLayout>
