---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects=[
{title:'NBS: No Bias Stereo',area:'STEREO VISION · REPRODUCTION',href:'/projects/nbs/',desc:'Reproducing and studying deep stereo matching with an emphasis on rigorous experiments and generalization.',tags:['PyTorch','Stereo','Depth Estimation']},
{title:'Vision-Language-Action Research',area:'EMBODIED AI',href:'/projects/vla/',desc:'Exploring action-policy learning and multimodal perception for embodied robotic tasks.',tags:['VLA','Robot Learning']},
{title:'Multi-view 3D Reconstruction',area:'COMPUTER VISION · GEOMETRY',href:'/projects/3d-reconstruction/',desc:'Investigating multi-camera 3D reconstruction and geometric representations for embodied applications.',tags:['3D Vision','Multi-view']}
];
---
<BaseLayout active="home"><section class="pt-4 pb-16">
<p class="section-label mb-5">Research & Engineering Portfolio</p>
<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight">Hi, I'm <span class="text-primary">Jianguo Shu.</span></h1>
<h2 class="text-2xl md:text-3xl font-semibold mt-6">Computer Vision · 3D Reconstruction · Embodied AI</h2>
<p class="text-lg leading-8 text-base-content/75 mt-7 max-w-3xl">I am a master's student exploring visual perception and 3D understanding for intelligent systems. My interests include stereo depth estimation, heterogeneous multi-view reconstruction, and vision-language-action models.</p>
<p class="text-sm text-base-content/60 mt-4">An evolving collection of research experiments, implementations, and technical notes.</p>
<div class="mt-9 flex flex-wrap gap-3"><a class="btn btn-primary" href="/projects/">Explore projects ↗</a><a class="btn btn-outline" href="/cv/">About & CV</a><a class="btn btn-ghost" href="https://github.com/shujianguosjg-dot" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></section>
<section class="pt-12 border-t border-base-300"><div class="flex justify-between items-end gap-4 mb-8"><div><p class="section-label">Selected work</p><h2 class="text-3xl font-bold mt-2">Research projects</h2></div><a href="/projects/" class="link link-primary">All projects →</a></div>
<div class="grid md:grid-cols-2 gap-5">{projects.map(p=><a href={p.href} class="research-card block group"><p class="section-label mb-4">{p.area}</p><h3 class="text-2xl font-bold group-hover:text-primary">{p.title} ↗</h3><p class="text-base-content/70 leading-7 mt-4">{p.desc}</p><div class="mt-5 flex flex-wrap gap-2">{p.tags.map(t=><span class="badge badge-outline badge-sm">{t}</span>)}</div></a>)}</div></section>
<section class="mt-16 bg-base-200 p-8 rounded-2xl"><p class="section-label">Currently exploring</p><h2 class="text-2xl font-bold mt-3">From reproducibility to practical perception systems</h2><p class="mt-3 text-base-content/70 leading-8">I focus on understanding modern visual geometry and building experimental pipelines. Verified results and limitations will be clearly distinguished as projects evolve.</p></section>
</BaseLayout>